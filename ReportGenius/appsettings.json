{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=KitchenManagement;Username=postgres;Password=681998;"
  },

  "Database": {
    "Provider": "PostgreSql",
    "CommandTimeout": 30,
    "EnableRetry": true,
    "MaxRetryCount": 3
  },

  "AI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1:8b",
    "Temperature": 0.3,
    "MaxTokens": 4096,
    "TimeoutSeconds": 880,
    "EnableLogging": true
  },

  "Cache": {
    "EnableCaching": true,
    "DefaultDurationInMinutes": 30
  },

  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": "",
    "ExpiryInMinutes": 60
  },

  "Swagger": {
    "Enable": true,
    "Title": "ReportGenius API",
    "Version": "v1",
    "Description": "Enterprise AI Reporting API"
  },

  "FileUpload": {
    "MaxFileSizeInMB": 20,
    "AllowedExtensions": [
      ".xlsx",
      ".xls",
      ".csv"
    ]
  },

  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  }

}
